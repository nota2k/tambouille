DATABASE_URL="postgresql://tambouille:tambouille@localhost:5432/tambouille?schema=public"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

PORT=3000

# Cloudflare R2 : dans le tableau de bord, R2 > Manage API tokens.
# Prends « ID de clé d'accès » et « Clé d'accès secrète » — surtout pas le jeton « cfat_… ».
R2_ACCOUNT_ID="changeme"
R2_ACCESS_KEY_ID="changeme"
R2_SECRET_ACCESS_KEY="changeme"
R2_BUCKET_NAME="tambouille"

FRONTEND_URL="http://localhost:5173"

# Identifiant client OAuth public, console Google Cloud. Pas de secret pour ce flux.
GOOGLE_CLIENT_ID="changeme.apps.googleusercontent.com"

# SMTP o2switch, pour le mail de réinitialisation de mot de passe — le seul
# mail que le site envoie. La boîte se crée dans cPanel > Comptes de messagerie ;
# SMTP_USER est l'adresse complète et SMTP_PASSWORD le mot de passe de la boîte.
#
# Ces variables sont lues au moment de l'envoi, pas au démarrage : si l'une
# manque, seule la réinitialisation casse, avec une erreur qui la nomme. Le
# reste de l'API démarre normalement.
SMTP_HOST="changeme.o2switch.net"
# 465 = TLS implicite (défaut). 587 = STARTTLS, mettre alors SMTP_SECURE="false".
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="changeme@example.com"
SMTP_PASSWORD="changeme"
# Expéditeur affiché. Doit appartenir au domaine, sinon o2switch refuse l'envoi.
SMTP_FROM="Tambouille <changeme@example.com>"
