DATABASE_URL="postgresql://tambouille:tambouille@localhost:5432/tambouille?schema=public"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

PORT=3000

# Cloudflare R2 : dans le tableau de bord, R2 > Manage API tokens.
# Prends « ID de clé d'accès » et « Clé d'accès secrète » — surtout pas le jeton « cfat_… ».
R2_ACCOUNT_ID="changeme"
R2_ACCESS_KEY_ID="changeme"
R2_SECRET_ACCESS_KEY="changeme"
R2_BUCKET_NAME="tambouille"

FRONTEND_URL="http://localhost:5173"

# Identifiant client OAuth public, console Google Cloud. Pas de secret pour ce flux.
GOOGLE_CLIENT_ID="changeme.apps.googleusercontent.com"

# SMTP, pour le mail de réinitialisation de mot de passe — le seul mail que le
# site envoie. En production c'est o2switch : la boîte se crée dans cPanel >
# Comptes de messagerie, SMTP_USER est l'adresse complète et SMTP_PASSWORD le
# mot de passe de la boîte.
#
# Ces variables sont lues à la première tentative d'envoi, jamais pendant la
# construction du graphe de modules : si l'une manque, seule la réinitialisation
# casse, avec une erreur qui la nomme, et le reste de l'API démarre normalement.
# Le démarrage tente quand même une connexion pour te prévenir tôt, mais cette
# vérification ne peut pas empêcher l'API de démarrer — elle ne fait que loguer.
#
# Les valeurs ci-dessous sont celles de Mailpit (docker compose up -d), qui
# accepte tout sans authentification et affiche les messages sur
# http://localhost:8025. Laisser SMTP_USER vide désactive l'authentification.
SMTP_HOST="localhost"
# 465 = TLS implicite. 587 = STARTTLS. 1025 = Mailpit, en clair.
SMTP_PORT=1025
# Exactement "true" ou "false" : toute autre valeur est refusée plutôt que lue
# comme false en silence.
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Expéditeur affiché. En production il doit appartenir au domaine, sinon
# o2switch refuse l'envoi.
SMTP_FROM="Tambouille <no-reply@pantagruweb.club>"

# Realm Keycloak du club, pour la connexion par carte de membre. Ces deux
# variables sont lues à la première tentative de connexion par carte, jamais au
# démarrage : si l'une manque, seul ce chemin casse, avec une erreur qui la
# nomme, et le reste de l'API démarre normalement.
KEYCLOAK_ISSUER="https://cartemembre.jeancloude.club/realms/jeancloude.club"
# Client public : pas de secret, l'identifiant voyage déjà dans l'URL d'autorisation.
KEYCLOAK_CLIENT_ID="tambouille"
