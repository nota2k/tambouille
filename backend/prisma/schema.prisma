// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  username    String   @unique
  password    String
  displayName String
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mixes       Mix[]
  favorites   Favorite[]
  playHistory PlayHistory[]

  // Rows where this user is the one doing the following.
  following  Follow[] @relation("Following")
  // Rows where this user is being followed (their followers).
  followedBy Follow[] @relation("Followers")

  @@map("users")
}

model Mix {
  id           String   @id @default(uuid())
  title        String
  description  String?
  audioUrl     String
  coverUrl     String?
  durationSec  Int?
  playsCount   Int      @default(0)
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tracklist   TracklistEntry[]
  favorites   Favorite[]
  playHistory PlayHistory[]

  @@index([userId])
  @@index([createdAt])
  @@map("mixes")
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mixId String
  mix   Mix    @relation(fields: [mixId], references: [id], onDelete: Cascade)

  @@unique([userId, mixId])
  @@index([mixId])
  @@map("favorites")
}

model Follow {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  followerId String
  follower   User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)

  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
  @@map("follows")
}

model PlayHistory {
  id       String   @id @default(uuid())
  playedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mixId String
  mix   Mix    @relation(fields: [mixId], references: [id], onDelete: Cascade)

  @@unique([userId, mixId])
  @@index([userId])
  @@map("play_history")
}

model TracklistEntry {
  id          String @id @default(uuid())
  artist      String
  title       String
  timecodeSec Int

  mixId String
  mix   Mix    @relation(fields: [mixId], references: [id], onDelete: Cascade)

  @@index([mixId])
  @@map("tracklist_entries")
}
