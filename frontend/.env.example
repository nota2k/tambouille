VITE_API_BASE_URL=http://localhost:3000/api
# Le domaine personnalisé branché sur le bucket R2, et non son URL en
# `r2.dev` : celle-ci est limitée en débit et Cloudflare n'y offre ni cache
# ni contrôle d'accès, elle ne vaut que pour le développement.
VITE_R2_PUBLIC_URL=https://changeme.example.com
VITE_GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com

# Realm Keycloak du club. Le client est public : son identifiant n'est pas un
# secret, il voyage déjà dans l'URL d'autorisation.
VITE_KEYCLOAK_ISSUER=https://cartemembre.jeancloude.club/realms/jeancloude.club
VITE_KEYCLOAK_CLIENT_ID=tambouille
